# Trimmed for this repo: uv/hatchling Python GUI (wifi_spectrum/), ESP-IDF
# v6.0.3 C firmware (firmware/), host tests, EIM/Podman/wslc build outputs.
# Based on https://github.com/github/gitignore @ 0e5d690 (main): Python.gitignore,
# C.gitignore, CMake.gitignore, Global/{macOS,Windows,Linux}.gitignore.
# Tracked on purpose: uv.lock, firmware/dependencies.lock, Makefile,
# firmware/**/CMakeLists.txt, firmware/main/idf_component.yml,
# firmware/sdkconfig.defaults, tests/, docs/.

# --- Python ---
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Build / packaging (uv build, hatchling)
build/
dist/
*.egg-info/

# Ruff / clangd index cache
.ruff_cache/
.cache/

# Virtual environments; local env/secret files stay untracked
.env
.env.*
!.env.example
.envrc
.venv/
env/
venv/

# PyPI credential file
.pypirc

# --- C / CMake leftovers outside build/ ---
*.o
*.obj
*.elf
*.map
*.exe
CMakeCache.txt
CMakeFiles/
CMakeLists.txt.user

# Generated by the IDF build (CMAKE_EXPORT_COMPILE_COMMANDS) for LSP use
compile_commands.json

# ESP-IDF: cached managed components + generated sdkconfig
managed_components/
sdkconfig
sdkconfig.old

# Local evidence, device inventories and agent histories are never public.
.hermes/
.local/
captures/
*.raw.bin
*.reg
shots-win/

# Manual/EIM build logs
*.log

# --- Editor / OS junk ---
*~
*.swp
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
